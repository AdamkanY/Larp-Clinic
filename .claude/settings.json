{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_claude_md.py\" --session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_claude_md.py\"",
            "timeout": 60,
            "statusMessage": "Checking that the CLAUDE.md guides are up to date"
          }
        ]
      }
    ]
  }
}
